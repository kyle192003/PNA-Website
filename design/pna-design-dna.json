{
  "meta": {
    "brand": "Philippine Nurses Association, Inc.",
    "surface": "public marketing folio",
    "source": "Existing PNA Website homepage + globals.css tokens",
    "updated": "2026-07-21"
  },
  "design_system": {
    "color": {
      "primary": "#14532d",
      "secondary": "#15803d",
      "accent": "#16a34a",
      "accent_light": "#22c55e",
      "accent_soft": "#4ade80",
      "background": "#f7faf8",
      "surface": "#ecfdf5",
      "surface_elevated": "#d1fae5",
      "ink": "#14532d",
      "ink_soft": "#1a3d2e",
      "muted": "#4b6b5c",
      "border": "rgba(21, 128, 61, 0.2)",
      "white": "#ffffff"
    },
    "typography": {
      "display_family": "Source Serif 4",
      "body_family": "Inter",
      "display_weight": 500,
      "body_weight": 400,
      "scale_ratio": 1.25,
      "letter_spacing_display": "-0.01em"
    },
    "spacing": {
      "section_y": "4rem",
      "section_y_lg": "5rem",
      "content_gap": "1.5rem",
      "density": "editorial-open"
    },
    "layout": {
      "max_width": "1120px",
      "columns": 12,
      "hero": "full-bleed cinematic brand plane",
      "alignment": "left-weighted editorial"
    },
    "shape": {
      "radius_control": "0.375rem to 9999px for pills",
      "dividers": "soft green hairlines"
    },
    "elevation": {
      "style": "minimal",
      "shadow": "soft green-tinted or none"
    },
    "motion": {
      "ease_enter": "power2.out",
      "ease_reveal": "power3.out",
      "duration_hero_step": 0.7,
      "duration_reveal": 0.85,
      "stagger": 0.12,
      "y_offset": 28
    },
    "components": {
      "cta": "editorial rectangular buttons in deep green",
      "nav": "fixed editorial header with brand badge"
    }
  },
  "design_style": {
    "mood": "calm institutional authority",
    "visual_language": "editorial conference folio",
    "composition": "brand-first hero, one job per section",
    "imagery": "real conference atmosphere photography",
    "interaction_feel": "deliberate, restrained, professional",
    "brand_voice": "formal Philippine Nurses Association, Inc.",
    "ornamentation": "low",
    "whitespace": "generous but structured"
  },
  "visual_effects": {
    "overview": {
      "effect_intensity": "medium-low",
      "performance_tier": "lightweight"
    },
    "scroll_driven": {
      "enabled": true,
      "notes": "GSAP ScrollTrigger section reveals on all public pages via SitePageMotion"
    },
    "timeline_hero": {
      "enabled": true,
      "notes": "GSAP timeline on homepage cinematic hero and editorial page heroes"
    },
    "admin_motion": {
      "enabled": true,
      "notes": "Subtle GSAP reveals on admin dashboard and cards via AdminPageMotion"
    },
    "webgl": {
      "enabled": false,
      "notes": "Three.js exists elsewhere; not applied to marketing folio hero"
    },
    "particles": { "enabled": false },
    "shaders": { "enabled": false },
    "glassmorphism": { "enabled": false },
    "cursor_effects": { "enabled": false }
  }
}
