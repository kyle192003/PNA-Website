# =============================================================================
# Public (browser-safe). ONLY NEXT_PUBLIC_* values are sent to the frontend.
# Use a referrer-restricted / limited key here — never an admin or write key.
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Maps/Places browser key restricted to your site HTTP referrers.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: show React Query devtools in development.
# NEXT_PUBLIC_RQ_DEVTOOLS=true

# =============================================================================
# Server-only admin / write keys. Never prefix these with NEXT_PUBLIC_.
# =============================================================================

# Admin dashboard password (required in production)
ADMIN_PASSWORD=pna-admin-dev

# Required in production: dedicated session / token signing secret (long random string).
# Falls back to ADMIN_PASSWORD only outside production.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-session-secret

# Optional server fallback if NEXT_PUBLIC_SITE_URL is unset (emails/QR on the server).
# SITE_URL=http://localhost:3000

# Vercel Blob write token (admin). Frontend only uses public blob URLs, never this token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ACCESS=public

# Optional IP-restricted Maps/Places server key for /api/places. Do not expose to the browser.
# GOOGLE_MAPS_SERVER_API_KEY=

# --- Email (SMTP) ---
# Required for registration confirmation, payment rejection, and reminder emails.
# Leave unset to skip sending (actions still succeed; failures are logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PNA Conference <noreply@example.com>"

# --- Admin inquiry alerts ---
# Preferred: uses the SMTP settings above to email ADMIN_NOTIFY_EMAIL (or conference.contact.email).
# Optional fallback: Web3Forms access key if SMTP is unavailable.
WEB3FORMS_ACCESS_KEY=
ADMIN_NOTIFY_EMAIL=

# --- Cron / reminders ---
# Protects GET|POST /api/cron/reminders
# Example: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/reminders
# Also used by /api/cron/engagement (evaluation invites + promotions)
# Query-string ?secret= is not accepted.
CRON_SECRET=change-me-to-a-long-random-string
