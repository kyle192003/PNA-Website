# Admin dashboard password (required in production)
ADMIN_PASSWORD=pna-admin-dev

# Optional: dedicated session signing secret (falls back to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Public site URL used in QR codes and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (SMTP) ---
# Required for registration confirmation, payment rejection, and reminder emails.
# Leave unset to skip sending (actions still succeed; failures are logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PNA Conference <noreply@example.com>"

# --- Admin inquiry alerts ---
# Preferred: uses the SMTP settings above to email ADMIN_NOTIFY_EMAIL (or conference.contact.email).
# Optional fallback: Web3Forms access key if SMTP is unavailable.
WEB3FORMS_ACCESS_KEY=
ADMIN_NOTIFY_EMAIL=

# --- Cron / reminders ---
# Protects GET|POST /api/cron/reminders
# Example: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/reminders
# Also used by /api/cron/engagement (evaluation invites + promotions)
CRON_SECRET=change-me-to-a-long-random-string
